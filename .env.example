# Starter branding for this template.
# Copy to .env.local (or run `npm run setup:env`) and update values for your product/demo.

# App name shown in the top navigation and sidebar.
VITE_APP_NAME=Portfolio Dashboard

# Sidebar subtitle.
VITE_APP_SUBTITLE=Backtest Workspace

# Small label above the app name in the top navigation.
VITE_APP_NAV_LABEL=Workspace

# Main create action label in the top navigation.
VITE_APP_PRIMARY_ACTION_LABEL=New Run

# Short mark shown in the sidebar badge.
VITE_APP_MARK=PD

# Browser tab title suffix.
VITE_APP_TITLE_SUFFIX=Template

# Meta description used for SEO/share cards.
VITE_APP_DESCRIPTION=Portfolio dashboard template for backtest research workflows.
